    {
      "name": "90 Negative Tests",
      "item": [
        {
          "name": "[KNOWN BUG] Create prod - no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\r\nconsole.log(body);\r\n\r\npm.test(\"Create without token is rejected with 401\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\n// Cleanup: if the product was created anyway, delete it with the admin token\r\nif (pm.response.code === 201 && body.id) {\r\n    pm.sendRequest({\r\n        url: pm.environment.get(\"base_Url\") + \"/products/\" + body.id,\r\n        method: \"DELETE\",\r\n        header: { Authorization: \"Bearer \" + pm.environment.get(\"admin_auth_token\") }\r\n    }, function (err, res) {\r\n        console.log(\"Cleanup delete of \" + body.id + \":\", err ? err : res.code);\r\n    });\r\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{$randomProductName}}\",\r\n  \"description\": \"Negative test: create without token\",\r\n  \"price\": 10.0,\r\n  \"brand_id\": \"{{brand_id}}\",\r\n  \"category_id\": \"{{category_id}}\",\r\n  \"product_image_id\": \"{{product_image_id}}\",\r\n  \"is_location_offer\": false,\r\n  \"is_rental\": false,\r\n  \"co2_rating\": \"A\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
