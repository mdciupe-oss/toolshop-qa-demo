      "name": "92 Data-driven - product create",
      "item": [
        {
          "name": "Create prod - data-driven",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const caseName = pm.iterationData.get(\"casename\");\r\nlet name = pm.iterationData.get(\"name\") ?? \"\";\r\nconst rawPrice = pm.iterationData.get(\"price\");\r\n\r\n// \"LEN:120\" in the CSV means: generate a name that is exactly 120 characters long\r\nif (name.startsWith(\"LEN:\")) {\r\n    name = \"a\".repeat(Number(name.slice(4)));\r\n}\r\n\r\npm.variables.set(\"name\", name);\r\n\r\n// Numbers go into the body as numbers; anything else goes in as quoted text\r\nconst priceIsNumber = rawPrice !== \"\" && !isNaN(Number(rawPrice));\r\npm.variables.set(\"price_json\", priceIsNumber ? rawPrice : JSON.stringify(rawPrice));\r\n\r\nconsole.log(`${caseName}: name length ${name.length}, price ${rawPrice}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const caseName = pm.iterationData.get(\"casename\");\r\nconst expected = Number(pm.iterationData.get(\"expectedStatus\"));\r\n\r\nlet body = {};\r\ntry { body = pm.response.json(); } catch (e) { console.log(\"Response is not JSON\"); }\r\nconsole.log(caseName, pm.response.code, body);\r\n\r\npm.test(`${caseName}: returns ${expected}`, function () {\r\n    pm.expect(pm.response.code).to.equal(expected);\r\n});\r\n\r\nif (pm.response.code === 201 && body.id) {\r\n    pm.test(`${caseName}: saved values match what was sent`, function () {\r\n        pm.expect(body.name).to.equal(pm.variables.get(\"name\"));\r\n        pm.expect(Number(body.price)).to.equal(Number(pm.iterationData.get(\"price\")));\r\n    });\r\n\r\n    // Cleanup: delete what was created\r\n    pm.sendRequest({\r\n        url: pm.environment.get(\"base_Url\") + \"/products/\" + body.id,\r\n        method: \"DELETE\",\r\n        header: { Authorization: \"Bearer \" + pm.environment.get(\"admin_auth_token\") }\r\n    }, function (err, res) {\r\n        console.log(`Cleanup ${caseName} (${body.id}):`, err ? err : res.code);\r\n    });\r\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
